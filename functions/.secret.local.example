# Local secret overrides for the Firebase Functions emulator.
#
# Copy this file next to it as `.secret.local` and fill in real values:
#
#     copy functions\.secret.local.example functions\.secret.local
#
# The Functions emulator reads it on start, so restart the emulator after
# editing. `.secret.local` is gitignored — never commit real values.
#
# Without DEEPSEEK_API_KEY the functions still load, but `requestSuggestion`
# fails and the chat screen sits on "Reading the conversation…" forever,
# because the emulator cannot reach Secret Manager to substitute a value.

# Required for the AI coach: requestSuggestion, analyzeConversation,
# generateSuggestion, and the onMessageCreated trigger.
# Create one at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Only needed if you exercise the billing flow.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_TOPUP_5=
STRIPE_PRICE_PREMIUM=
